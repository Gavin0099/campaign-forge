    ~ trust_lis -= 1
    #flag:sawin_sheltered
    #speaker:薩溫
    「……謝謝。我會證明的。」
    #speaker:蕾絲
    「我會盯著你。」
* [請托瑪先替他壓住裂潮再說。]
    ~ sawin_sheltered = true
    ~ trust_thoma += 1
    #flag:sawin_sheltered
    #speaker:托瑪
